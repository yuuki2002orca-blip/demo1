# Anthropic API キー
# https://console.anthropic.com/ で取得してください
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# X (Twitter) API 認証情報
# https://developer.twitter.com/en/portal/dashboard で取得してください
# Free プランでも投稿は可能ですが、1ヶ月500ツイートまでの制限があります
X_API_KEY=your-api-key
X_API_SECRET=your-api-secret
X_ACCESS_TOKEN=your-access-token
X_ACCESS_TOKEN_SECRET=your-access-token-secret

# note.com ログイン情報
# note.com のメールアドレスとパスワードをそのまま設定してください
NOTE_EMAIL=your-email@example.com
NOTE_PASSWORD=your-note-password
